build RelWithDebInfo/nfcDemoApp: C_EXECUTABLE_LINKER__nfcDemoApp_RelWithDebInfo CMakeFiles/nfcDemoApp.dir/RelWithDebInfo/demoapp/main.c.o CMakeFiles/nfcDemoApp.dir/RelWithDebInfo/demoapp/tools.c.o | custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so.0.0.0 || custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so
  CONFIG = RelWithDebInfo
  FLAGS = -O2 -g -DNDEBUG
  LINK_LIBRARIES = -Wl,-rpath,/home/mili/pn7160-nxp-fork/build/fixes-multi/custom-lib/RelWithDebInfo:  custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so.0.0.0  -ldl  -lrt
  OBJECT_DIR = CMakeFiles/nfcDemoApp.dir/RelWithDebInfo
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/nfcDemoApp.dir/RelWithDebInfo/
  TARGET_FILE = RelWithDebInfo/nfcDemoApp
  TARGET_PDB = RelWithDebInfo/nfcDemoApp.pdb
  TARGET_SUPPORT_DIR = CMakeFiles/nfcDemoApp.dir


#############################################
# Custom command for CMakeFiles/pn7160-library-alias-RelWithDebInfo

build CMakeFiles/pn7160-library-alias-RelWithDebInfo | ${cmake_ninja_workdir}CMakeFiles/pn7160-library-alias-RelWithDebInfo: CUSTOM_COMMAND custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so.0.0.0 || custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so
  COMMAND = cd /home/mili/pn7160-nxp-fork/build/fixes-multi && /home/mili/.local/lib/python3.10/site-packages/cmake/data/bin/cmake -E create_symlink libnfc_nci_linux-1.so.0.0.0 /home/mili/pn7160-nxp-fork/build/fixes-multi/custom-lib/RelWithDebInfo/libnfc_nci_linux.so

build libnfc_nci_linux-1.so$:RelWithDebInfo: phony custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so

build libpn7160_fw.so$:RelWithDebInfo: phony custom-lib/RelWithDebInfo/libpn7160_fw.so

build nfcDemoApp$:RelWithDebInfo: phony RelWithDebInfo/nfcDemoApp

build nfc_nci_linux$:RelWithDebInfo: phony custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so

build pn7160_fw$:RelWithDebInfo: phony custom-lib/RelWithDebInfo/libpn7160_fw.so


#############################################
# Folder: /home/mili/pn7160-nxp-fork/build/fixes-multi

build all$:RelWithDebInfo: phony custom-lib/RelWithDebInfo/libnfc_nci_linux-1.so pn7160-library-alias$:RelWithDebInfo custom-lib/RelWithDebInfo/libpn7160_fw.so RelWithDebInfo/nfcDemoApp


#############################################
# Clean all the built files.

build clean$:RelWithDebInfo: CLEAN
  FILE_ARG = -f CMakeFiles/impl-RelWithDebInfo.ninja
  TARGETS = CMakeFiles/cmake_byproducts_for_clean_target:RelWithDebInfo CMakeFiles/cmake_byproducts_for_clean_target

